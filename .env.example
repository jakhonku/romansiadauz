# =============================================================================
# Romansiada Uzbekistan — environment variables
# =============================================================================
# Copy to `.env.local` for development. On Vercel, set the same keys under
# Project → Settings → Environment Variables.
#
# `.env.local` is git-ignored. Never commit real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Dashboard → Project Settings → API → service_role.
# SERVER-ONLY. This key bypasses Row Level Security completely. It must never be
# prefixed with NEXT_PUBLIC_ and must never appear in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Site (required in production)
# -----------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, hreflang,
# sitemap.xml, robots.txt and OpenGraph image URLs.
NEXT_PUBLIC_SITE_URL=https://romasiada.uz

# -----------------------------------------------------------------------------
# Outbound mail (optional)
# -----------------------------------------------------------------------------
# Used for application confirmations and contact-form notifications. If unset,
# the site works normally and simply sends no mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Romansiada Uzbekistan <no-reply@romasiada.uz>"
