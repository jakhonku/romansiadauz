  "about": {
    "title": "About the festival",
    "subtitle": "History, mission and objectives",
    "history": {
      "kicker": "History",
      "title": "Our journey",
      "body": "The Romansiada movement began with a simple idea: to pass the art of the romance song on to a new generation. Over the years the festival has brought thousands of performers from dozens of countries onto one stage and has become one of the most respected vocal competitions in the region."
    },
    "mission": {
      "kicker": "Mission",
      "title": "Our mission",
      "body": "To preserve the romance genre, to open a professional stage to young talent, and to strengthen friendship between nations through music."
    },
    "vision": {
      "kicker": "Vision",
      "title": "Looking ahead",
      "body": "To make Romansiada Uzbekistan the leading centre of romance singing in Central Asia and to open an international career path for its winners."
    },
    "objectives": {
      "kicker": "Objectives",
      "title": "Core objectives",
      "items": [
        {
          "title": "Discovering talent",
          "body": "Finding and supporting young vocalists from every region of the country."
        },
        {
          "title": "Preserving heritage",
          "body": "Collecting, recording and passing the classical romance repertoire to a new generation."
        },
        {
          "title": "Professional growth",
          "body": "Developing performers through masterclasses, mentorship and studio recordings."
        },
        {
          "title": "Cultural diplomacy",
          "body": "Presenting the culture of Uzbekistan to the world through international cooperation."
        }
      ]
    },
