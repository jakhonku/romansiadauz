# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. Anyone deploying needs to know which variables
# exist; it holds names and placeholders, never a real value.
!.env.example

# vercel
.vercel

# local agent settings
.claude

# Source documents handed over by the organisers: the Regulations, the repertoire
# annex and 212 MB of PDF scores. The scores are served from the `scores` bucket in
# Supabase Storage and the two Word files have been transcribed into the dictionaries
# and `src/content/scores.ts`, so nothing here is needed to build or run the site —
# and a git history carrying a quarter of a gigabyte of scans cannot be undone.
/malumot

# typescript
*.tsbuildinfo
next-env.d.ts
